NODE_ENV=development
PORT=3000
# Interface to listen on. 127.0.0.1 = this machine only (safe default for local development).
# Cloud/browser IDEs and containers usually need HOST=0.0.0.0 so the preview URL can reach the app.
# Never use 0.0.0.0 on a shared or public network: there is no authentication yet.
HOST=127.0.0.1
APP_NAME=USDJPY Workstation
# Database and AI credentials will be added in later milestones.
# Never place secrets in frontend files.
